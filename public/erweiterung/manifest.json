{
  "manifest_version": 3,
  "name": "JobPilot : formulaires employeurs",
  "version": "1.3.0",
  "description": "Préremplit les champs reconnus avec les réponses vérifiées du candidat. Aucun envoi automatique. Bulle JP pour les candidatures ouvertes depuis JobPilot.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3037/*", "http://127.0.0.1:3037/*"],
      "js": ["jobpilot-seite.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot Assistent",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  }
}
